# =========================================================================
# ResumeIntel Studio - Git Ignore & Security Policy
# Ensures all secrets, credentials, environment files and build artifacts
# are completely excluded from Git and prevented from leaking to public repos.
# =========================================================================

# 1. Critical Environment & Secrets
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert
*.crt
secrets.json
credentials.json
id_rsa
id_rsa.pub

# 2. Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
.npm/
.vite/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 3. Python & AI Microservice
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.installed.cfg
*.egg
ai-service/storage/
storage/

# 4. Java / Spring Boot Build Outputs
target/
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
.mvn/wrapper/maven-wrapper.jar
.gradle/
build/

# 5. Databases & Local Storage
*.db
*.sqlite
*.sqlite3
pgdata/
redisdata/

# 6. IDEs & Operating System Artifacts
