# =========================================================================
# ResumeIntel AI - Environment Configuration Template
# Copy this file to .env and configure with your credentials
# =========================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_DB=resumeintel_db
POSTGRES_USER=resumeintel_user
POSTGRES_PASSWORD=resumeintel_secure_pass_2026
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Spring Boot Backend Security
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
JWT_EXPIRATION_HOURS=24
SERVER_PORT=8080

# AI Microservice Configuration
AI_SERVICE_PORT=8000
DEFAULT_LLM_PROVIDER=gemini # gemini, openai, groq, or mock

# AI & LLM Provider API Keys (Fill with your preferred provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Web Search Provider API Keys (For Company Research Agent)
TAVILY_API_KEY=
SERPER_API_KEY=

# Document Storage Path
DOCUMENT_STORAGE_PATH=./storage

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api
FRONTEND_PORT=3000
