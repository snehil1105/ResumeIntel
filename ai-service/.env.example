# =========================================================================
# ResumeIntel AI Microservice - Environment Configuration Example
# Copy this file to .env and fill in your API keys before running.
# Never commit the actual .env file to Git!
# =========================================================================

# Server Port
AI_SERVICE_PORT=8000

# Default LLM Provider: 'gemini', 'openai', 'groq', or 'mock'
# If no API key is provided, the service defaults to deterministic mock mode safely.
DEFAULT_LLM_PROVIDER=gemini

# AI & LLM Provider API Keys (Fill at least one for live AI generation)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Web Search Provider API Keys (For Company Research Agent live lookups)
TAVILY_API_KEY=
SERPER_API_KEY=

# Storage Directory for parsed files
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=10

# Database & Cache URLs (Optional for standalone mode)
DATABASE_URL=postgresql://resumeintel_user:resumeintel_secure_pass_2026@localhost:5432/resumeintel_db
REDIS_URL=redis://localhost:6379/0
